@param java.util.List<com.erplancers.erp.accounting.domain.Account> accounts
@param java.util.List<com.erplancers.erp.accounting.domain.FiscalYear> fiscalYears
@param java.util.List<com.erplancers.erp.accounting.domain.FiscalPeriod> fiscalPeriods
@param java.util.List<com.erplancers.erp.accounting.domain.CostCenter> costCenters
@param java.util.List<com.erplancers.erp.accounting.domain.ProfitCenter> profitCenters

<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ERP | Accounting Reports</title><link rel="stylesheet" href="/webjars/bootstrap/5.3.8/css/bootstrap.min.css">
<style>body{background:#f5f7fa;color:#172033}.panel{background:#fff;border:1px solid #e7eaf0;border-radius:16px}.muted{color:#667085}.label{font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:#667085}.report-card{background:#fff;border:1px solid #e7eaf0;border-radius:16px;transition:.15s}.report-card:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(16,24,40,.08)}</style>
</head><body><nav class="navbar bg-white border-bottom"><div class="container-fluid px-4 py-2"><a class="navbar-brand fw-semibold" href="/app">ERP Operations</a><a class="btn btn-sm btn-outline-secondary" href="/app/module/accounting">Accounting</a></div></nav>
<main class="container-fluid px-4 py-4"><div class="mb-4"><div class="label">Accounting domain</div><h1 class="display-6 fw-semibold mb-1">Financial reports</h1><p class="muted mb-0">Entity-specific ERP reporting backed by accounting services and domain repositories.</p></div>
<div class="row g-3 mb-4">
<div class="col-md-6 col-xl-3"><div class="report-card p-4 h-100"><div class="label">Accounts</div><h2 class="h5 mt-2">Account balance</h2><p class="muted small">Debit, credit and balance for a ledger account.</p><form method="get" action="/app/accounting/reports/accounts"><select class="form-select mb-2" name="accountId" onchange="if(this.value)location.href='/app/accounting/reports/accounts/'+this.value"><option value="">Select account</option>@for(var a : accounts)<option value="@a.getId()">@a.getCode() - @a.getName()</option>@endfor</select></form></div></div>
<div class="col-md-6 col-xl-3"><div class="report-card p-4 h-100"><div class="label">General ledger</div><h2 class="h5 mt-2">Account ledger</h2><p class="muted small">Transactions and running balance for an account.</p><select class="form-select" onchange="if(this.value)location.href='/app/accounting/reports/accounts/'+this.value+'/ledger'"><option value="">Select account</option>@for(var a : accounts)<option value="@a.getId()">@a.getCode() - @a.getName()</option>@endfor</select></div></div>
<div class="col-md-6 col-xl-3"><div class="report-card p-4 h-100"><div class="label">Fiscal year</div><h2 class="h5 mt-2">Fiscal summary</h2><p class="muted small">Account and period totals for a fiscal year.</p><select class="form-select" onchange="if(this.value)location.href='/app/accounting/reports/fiscal-years/'+this.value"><option value="">Select year</option>@for(var y : fiscalYears)<option value="@y.getId()">@y.getFiscalYear()</option>@endfor</select></div></div>
<div class="col-md-6 col-xl-3"><div class="report-card p-4 h-100"><div class="label">Cost / profit</div><h2 class="h5 mt-2">Management reports</h2><p class="muted small">Drill into cost and profit center activity.</p><div class="d-grid gap-2"><select class="form-select" onchange="if(this.value)location.href='/app/accounting/reports/cost-centers/'+this.value"><option value="">Cost center</option>@for(var c : costCenters)<option value="@c.getId()">@c.getCode() - @c.getName()</option>@endfor</select><select class="form-select" onchange="if(this.value)location.href='/app/accounting/reports/profit-centers/'+this.value"><option value="">Profit center</option>@for(var p : profitCenters)<option value="@p.getId()">@p.getCode() - @p.getName()</option>@endfor</select></div></div></div>
</div>
<div class="panel p-4"><div class="label">Reporting model</div><h2 class="h5 mt-2">Domain → entity → report</h2><p class="muted mb-0">Accounting owns the report services for Account, JournalEntry, FiscalYear/FiscalPeriod, CostCenter and ProfitCenter. The MVC layer only orchestrates filters and renders the service DTOs.</p></div>
</main></body></html>