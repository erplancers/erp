@param java.util.Map<String, Long> modules
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ERP Reports</title><link rel="stylesheet" href="/webjars/bootstrap/5.3.8/css/bootstrap.min.css"></head><body class="bg-body-tertiary"><nav class="navbar bg-white border-bottom"><div class="container-fluid px-4"><a class="navbar-brand fw-semibold" href="/app">ERP Operations</a></div></nav><main class="container-fluid px-4 py-4"><h1 class="display-6 fw-semibold">ERP reports</h1><p class="text-muted">Domain and entity-specific reporting across all modules.</p><div class="row g-3">@for(var e : modules.entrySet())<div class="col-sm-6 col-lg-4 col-xl-3"><a class="card d-block text-decoration-none text-reset p-4 h-100" href="/app/reports/@e.getKey()"><div class="text-uppercase small text-muted">@e.getKey()</div><div class="h5 mt-2 text-capitalize">@e.getKey() reports</div><div class="text-muted small">@e.getValue() entities</div></a></div>@endfor</div></main></body></html>