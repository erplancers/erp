# Format: source_column:logical_alias,...; aliases are what Spark jobs and feature lists reference.
analytics.datasets.sales_orders.table=YOUR_ORDER_ENTITY
analytics.datasets.sales_orders.columns=YOUR_SCOPE_RELATION_ID_PATH:customer_id,YOUR_ORDER_ID_ATTRIBUTE:order_id,YOUR_ORDER_DATE_ATTRIBUTE:order_date,YOUR_NET_AMOUNT_ATTRIBUTE:net_amount
analytics.datasets.sales_orders.tenant-column=none
analytics.datasets.sales_orders.scope-column=YOUR_SCOPE_RELATION_ID_PATH
analytics.datasets.sales_orders.scope-type=CONTACT

analytics.datasets.inventory_daily.table=YOUR_INVENTORY_ENTITY
analytics.datasets.inventory_daily.columns=YOUR_PRODUCT_ID_ATTRIBUTE:product_id,YOUR_WAREHOUSE_SCOPE_ID_PATH:warehouse_id,YOUR_BUSINESS_DATE_ATTRIBUTE:demand_date,YOUR_DAILY_DEMAND_ATTRIBUTE:demand_qty,YOUR_RECENT_DEMAND_ATTRIBUTE:recent_demand,YOUR_ON_HAND_STOCK_ATTRIBUTE:on_hand,YOUR_LEAD_TIME_ATTRIBUTE:lead_time_days,YOUR_STOCKOUT_LABEL_ATTRIBUTE:stockout_label
analytics.datasets.inventory_daily.tenant-column=none
analytics.datasets.inventory_daily.scope-column=YOUR_WAREHOUSE_SCOPE_ID_PATH
analytics.datasets.inventory_daily.scope-type=WAREHOUSE

analytics.datasets.receivables.table=YOUR_RECEIVABLE_ENTITY
analytics.datasets.receivables.columns=YOUR_SCOPE_RELATION_ID_PATH:customer_id,YOUR_INVOICE_ID_ATTRIBUTE:invoice_id,YOUR_DUE_DATE_ATTRIBUTE:due_date,YOUR_PAID_DATE_ATTRIBUTE:paid_date,YOUR_INVOICE_AMOUNT_ATTRIBUTE:invoice_amount,YOUR_OVERDUE_LABEL_ATTRIBUTE:overdue_label,YOUR_CUSTOMER_OVERDUE_RATE_ATTRIBUTE:customer_overdue_rate,YOUR_AVERAGE_PAYMENT_DELAY_ATTRIBUTE:historical_average_payment_delay,YOUR_PAYMENT_TERMS_ATTRIBUTE:payment_terms_days
analytics.datasets.receivables.tenant-column=none
analytics.datasets.receivables.scope-column=YOUR_SCOPE_RELATION_ID_PATH
