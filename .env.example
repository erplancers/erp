POSTGRES_PASSWORD=change-this-to-a-long-random-password
ERP_HTTP_PORT=8088

ERP_REGISTRATION_ADMIN_TOKEN=replace-with-a-long-random-admin-bootstrap-token

# Kafka broker exposed to host tools; containers use kafka:29092 internally.
KAFKA_EXTERNAL_PORT=9092

# Optional analytics-worker read-only DB identity; create/grant it before production use.
ANALYTICS_READ_USER=erplancers
ANALYTICS_READ_PASSWORD=change-this-to-a-long-random-password
