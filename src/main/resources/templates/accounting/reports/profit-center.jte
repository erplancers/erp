@param com.erplancers.erp.accounting.report.dto.ProfitCenterReport report
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ERP | Profit center</title><link rel="stylesheet" href="/webjars/bootstrap/5.3.8/css/bootstrap.min.css"></head>
<body class="bg-body-tertiary"><nav class="navbar bg-white border-bottom"><div class="container-fluid px-4"><a class="navbar-brand" href="/app/accounting/reports">Accounting Reports</a></div></nav>
<main class="container-fluid px-4 py-4"><div class="mb-4"><div class="text-uppercase text-muted small">Profit center</div><h1 class="h2">@report.profitCenterCode() · @report.profitCenterName()</h1><div class="text-muted">@report.from() → @report.to()</div></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card border-0 shadow-sm p-3">Debit <strong>@report.totalDebit()</strong></div></div><div class="col-md-4"><div class="card border-0 shadow-sm p-3">Credit <strong>@report.totalCredit()</strong></div></div><div class="col-md-4"><div class="card border-0 shadow-sm p-3">Balance <strong>@report.balance()</strong></div></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th>Date</th><th>Account</th><th>Description</th><th class="text-end">Debit</th><th class="text-end">Credit</th><th class="text-end">Balance</th></tr></thead><tbody>@for(var l : report.lines())<tr><td>@l.entryDate()</td><td>@l.accountCode() · @l.accountName()</td><td>@l.description()</td><td class="text-end">@l.debit()</td><td class="text-end">@l.credit()</td><td class="text-end">@l.balance()</td></tr>@endfor</tbody></table></div></div></main></body></html>