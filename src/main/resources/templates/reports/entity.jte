@param com.erplancers.erp.common.reporting.EntityReportService.EntityReport report
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ERP | @report.entity</title><link rel="stylesheet" href="/webjars/bootstrap/5.3.8/css/bootstrap.min.css"></head><body class="bg-body-tertiary"><nav class="navbar bg-white border-bottom"><div class="container-fluid px-4"><a class="navbar-brand fw-semibold" href="/app">ERP Operations</a><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-secondary" href="/app/reports/@report.module()">Module</a><a class="btn btn-sm btn-outline-secondary" href="/app/@report.slug()">Records</a></div></div></nav><main class="container-fluid px-4 py-4"><h1 class="display-6 fw-semibold">@report.entity report</h1><p class="text-muted">@report.count() records · sample-based metrics.</p><div class="row g-4"><div class="col-xl-7"><div class="card border-0 shadow-sm p-4"><h2 class="h5">Numeric metrics</h2>@if(report.numeric().isEmpty())<p class="text-muted">No numeric properties.</p>@endif @for(var e : report.numeric().entrySet())<div class="border-top py-3"><div class="fw-semibold">@e.getKey()</div><div class="fs-5">@e.getValue().sum()</div><div class="text-muted small">min @e.getValue().min() · max @e.getValue().max() · populated @e.getValue().populated()</div></div>@endfor</div></div><div class="col-xl-5"><div class="card border-0 shadow-sm p-4"><h2 class="h5">Enum distribution</h2>@if(report.enums().isEmpty())<p class="text-muted">No enum properties.</p>@endif @for(var e : report.enums().entrySet())<div class="border-top py-3"><div class="fw-semibold mb-2">@e.getKey()</div>@for(var v : e.getValue().entrySet())<div class="d-flex justify-content-between small"><span>@v.getKey()</span><strong>@v.getValue()</strong></div>@endfor</div>@endfor</div></div></div></main></body></html>