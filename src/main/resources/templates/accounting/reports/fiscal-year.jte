@param java.util.List<com.erplancers.erp.accounting.report.dto.AccountFiscalSummary> accountSummary
@param java.util.List<com.erplancers.erp.accounting.report.dto.FiscalPeriodSummary> periodSummary
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ERP | Fiscal year</title><link rel="stylesheet" href="/webjars/bootstrap/5.3.8/css/bootstrap.min.css"></head>
<body class="bg-body-tertiary"><nav class="navbar bg-white border-bottom"><div class="container-fluid px-4"><a class="navbar-brand" href="/app/accounting/reports">Accounting Reports</a></div></nav>
<main class="container-fluid px-4 py-4"><h1 class="h2 mb-4">Fiscal year summary</h1>
<div class="row g-4"><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><strong>Account summary</strong></div><div class="table-responsive"><table class="table table-sm table-striped mb-0"><thead><tr><th>Code</th><th>Name</th><th class="text-end">Debit</th><th class="text-end">Credit</th><th class="text-end">Balance</th></tr></thead><tbody>@for(var r : accountSummary)<tr><td>@r.accountCode()</td><td>@r.accountName()</td><td class="text-end">@r.debit()</td><td class="text-end">@r.credit()</td><td class="text-end fw-semibold">@r.balance()</td></tr>@endfor</tbody></table></div></div></div>
<div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-header bg-white"><strong>Period summary</strong></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Period</th><th class="text-end">Debit</th><th class="text-end">Credit</th></tr></thead><tbody>@for(var r : periodSummary)<tr><td>@r.fiscalPeriodId()</td><td class="text-end">@r.debit()</td><td class="text-end">@r.credit()</td></tr>@endfor</tbody></table></div></div></div></div></main></body></html>