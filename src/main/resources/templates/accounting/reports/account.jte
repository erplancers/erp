@param com.erplancers.erp.accounting.report.dto.AccountBalanceReport report
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ERP | Account report</title><link rel="stylesheet" href="/webjars/bootstrap/5.3.8/css/bootstrap.min.css"></head>
<body class="bg-body-tertiary"><nav class="navbar bg-white border-bottom"><div class="container-fluid px-4"><a class="navbar-brand" href="/app/accounting/reports">Accounting Reports</a><a class="btn btn-sm btn-outline-secondary" href="/app/accounting/reports">Back</a></div></nav>
<main class="container-fluid px-4 py-4"><div class="mb-4"><div class="text-uppercase text-muted small">Account</div><h1 class="display-6 fw-semibold">@report.accountCode() · @report.accountName()</h1></div>
<div class="row g-3"><div class="col-md-4"><div class="card border-0 shadow-sm p-4"><div class="text-muted small">Debit</div><div class="display-6">@report.totalDebit()</div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm p-4"><div class="text-muted small">Credit</div><div class="display-6">@report.totalCredit()</div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm p-4"><div class="text-muted small">Balance</div><div class="display-6">@report.balance()</div></div></div></div>
<div class="mt-4"><a class="btn btn-dark" href="/app/accounting/reports/accounts/@report.accountId()/ledger">Open general ledger</a></div></main></body></html>