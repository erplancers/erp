@param String module
@param java.util.List<com.erplancers.erp.common.reporting.EntityReportService.EntityReport> resources
@param long totalRecords
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ERP | @module</title><link rel="stylesheet" href="/webjars/bootstrap/5.3.8/css/bootstrap.min.css"></head><body class="bg-body-tertiary"><nav class="navbar bg-white border-bottom"><div class="container-fluid px-4"><a class="navbar-brand" href="/app">ERP Operations</a><a class="btn btn-sm btn-outline-secondary" href="/app/reports">All reports</a></div></nav><main class="container-fluid px-4 py-4"><h1 class="display-6 fw-semibold text-capitalize">@module reports</h1><p class="text-muted">@totalRecords records across @resources.size() entities.</p><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Entity</th><th>Resource</th><th class="text-end">Records</th><th></th></tr></thead><tbody>@for(var r : resources)<tr><td class="fw-semibold">@r.entity()</td><td class="text-muted">/@r.slug()</td><td class="text-end">@r.count()</td><td class="text-end"><a class="btn btn-sm btn-dark" href="/app/reports/@module/@r.slug()">Report</a></td></tr>@endfor</tbody></table></div></div></main></body></html>